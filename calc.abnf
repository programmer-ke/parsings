program = assignment / expr                                 ; a program is either an expression or assignment
assignment = variable "=" expr                              ; assigning an expression to a variable
expr = term expr_rhs                                        ; a left term and an expr right hand side
expr_rhs = *(("+" / "-") term)                              ; zero or more rhs terms for + and -
term = unary *(("*" / "/") unary)                           ; multiplication or division factors
unary = [ "-" / "+" ] factor                                ; unary op on factor
factor = float / integer / variable / "(" expr ")"          ; number, variable or bracketed expression
float = ( *DIGIT "." 1*DIGIT / 1*DIGIT "." *DIGIT )         ; float spec
integer = 1*DIGIT                                           ; integer spec
variable = 1*ALPHA *(ALPHA / DIGIT / "_" )                  ; a variable name (starts with alphabetic character)
